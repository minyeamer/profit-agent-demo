# Public local demo settings. Do not use these credentials for production.
PGHOST=demo-postgres
PGPORT=5432
PGDATABASE=profit_demo
PGUSER=demo_readonly
PGPASSWORD=demo_password
PGSCHEMA=analytics
PROFIT_DAILY_FUNCTION=analytics.profit_daily

# Hermes is used when OPENAI_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AGENT_BACKEND=auto
HERMES_COMMAND=hermes
HERMES_MAX_TURNS=12
STREAMLIT_PORT=8510
STREAMLIT_BIND_ADDRESS=0.0.0.0
