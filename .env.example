# 실제 비밀값을 입력하는 파일입니다. 이 파일은 git에 추가하지 마세요.

# LLM 설정: 서버 측에서만 사용합니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# LLM 실행 방식: auto(기본값)는 API key가 없으면 Hermes OAuth를 사용합니다.
AGENT_BACKEND=auto
HERMES_COMMAND=hermes
HERMES_MAX_TURNS=12

# PostgreSQL 설정: 서버 측에서만 사용합니다.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=analytics
PGUSER=readonly_user
PGPASSWORD=
PGSCHEMA=analytics

# 기본 테이블 함수. schema.function 형식만 허용합니다.
PROFIT_DAILY_FUNCTION=analytics.profit_daily

# Streamlit 서버 설정
STREAMLIT_PORT=8510
STREAMLIT_BIND_ADDRESS=127.0.0.1
