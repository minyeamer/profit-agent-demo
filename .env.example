# 실제 비밀값을 입력하는 파일입니다. 이 파일은 git에 추가하지 마세요.

# LLM API 설정: 서버 측에서만 사용합니다.
# API_TYPE은 openai 또는 nvidia입니다.
API_TYPE=openai
API_KEY=
# 제공자 기본 endpoint를 사용하려면 비워 두세요.
API_BASE_URL=
MODEL=gpt-4o-mini

# PostgreSQL 설정: 서버 측에서만 사용합니다.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=analytics
PGUSER=readonly_user
PGPASSWORD=
PGSCHEMA=analytics

# 기본 테이블 함수. schema.function 형식만 허용합니다.
PROFIT_DAILY_FUNCTION=analytics.profit_daily

# Streamlit 서버 설정
STREAMLIT_PORT=8510
STREAMLIT_BIND_ADDRESS=127.0.0.1
